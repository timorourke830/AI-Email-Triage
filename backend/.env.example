# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Encryption key for email credentials (64 hex characters = 32 bytes for AES-256)
# Must match the key in dashboard/.env.local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-string-here

# LLM Configuration
# Provider: 'openai' or 'anthropic'
LLM_PROVIDER=anthropic

# Anthropic (if using Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional: Override default model
# LLM_MODEL=claude-3-sonnet-20240229

# Server Configuration
PORT=3001

# Worker API Configuration
WORKER_API_KEY=your-random-worker-key
WORKER_API_URL=http://localhost:3001

# Note: WORKER_EMAIL and WORKER_EMAIL_PASSWORD are no longer needed
# Email credentials are now stored per-user in the database (encrypted)
