# Supabase Configuration
# Public variables (client-side safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Encryption key for email credentials (64 hex characters = 32 bytes for AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-string-here

# LLM Configuration (for worker)
# Provider: 'openai' or 'anthropic'
LLM_PROVIDER=openai

# OpenAI (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-key
# Optional: Override default model
# LLM_MODEL=gpt-4-turbo-preview

# Anthropic (if using Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional: Override default model
# LLM_MODEL=claude-3-sonnet-20240229

# Cron Secret (for securing the worker endpoint)
CRON_SECRET=your-random-secret-string

# Public Environment Variables (client-side)
# Leave empty when API routes are in the same project
NEXT_PUBLIC_API_URL=
